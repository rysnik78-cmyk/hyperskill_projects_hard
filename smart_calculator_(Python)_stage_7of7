    bool_right_string_digits = [letter in string.digits for letter in right_side_string]
    bool_right_string_ascii = [letter in string.ascii_letters for letter in right_side_string]

    # print(left_side_string)
    # print(right_side_string)
    if not(all(bool_left_string_ascii)):
        return 'Invalid identifier'

    v_name = left_side_string

    if not(all(bool_right_string_digits)):
        if not (all(bool_right_string_ascii)):
            return 'Invalid identifier'
        if not (right_side_string in variables.keys()):
            return 'Unknown variable'
        v_value = variables[right_side_string]
    else:
        v_value = int(right_side_string)

    variables[v_name] = v_value

    return 'ok'

